// Constraint file of the blinky example for the Sipeed Tang Nano 1K board.
// It assigns the design's signals to FPGA pins, and lists only
// the pins that this example uses.

// Clock (27MHz).
IO_LOC  "sys_clk" 47;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LED (the red part of the RGB LED), active low.
IO_LOC  "led" 9;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
