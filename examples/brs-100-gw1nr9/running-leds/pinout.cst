// Constraint file of the running-leds example for the BRS-100-GW1NR9 board.
// It assigns the design's signals to FPGA pins, and lists only
// the pins that this example uses.

// Clock (27MHz).
IO_LOC  "sys_clk" 52;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// LEDs, active low.
IO_LOC  "leds_n[0]" 16;
IO_LOC  "leds_n[1]" 15;
IO_LOC  "leds_n[2]" 14;
IO_LOC  "leds_n[3]" 13;
IO_LOC  "leds_n[4]" 11;
IO_LOC  "leds_n[5]" 10;
IO_PORT "leds_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "leds_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
