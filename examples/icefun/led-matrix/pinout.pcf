# Pinout for iceFUN board example

# LED rows (active low)
set_io rows_n[0]  C10
set_io rows_n[1]  A10
set_io rows_n[2]  D7
set_io rows_n[3]  D6
set_io rows_n[4]  A7
set_io rows_n[5]  C7
set_io rows_n[6]  A4
set_io rows_n[7]  C4

# LED columns (active low)
set_io cols_n[0]  A12
set_io cols_n[1]  D10
set_io cols_n[2]  A6
set_io cols_n[3]  C5

set_io sys_clk      P7

