# Constraint file of the blinky example for the Azukar v2 board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# ------------ System clock (12MHz) -------------------------------------------
set_io sys_clk 49  # input

# ------------ User Leds (active high) ----------------------------------------
set_io leds[0] 37  # output
set_io leds[1] 38  # output
set_io leds[2] 39  # output
set_io leds[3] 41  # output
set_io leds[4] 42  # output
set_io leds[5] 43  # output
set_io leds[6] 44  # output
set_io leds[7] 45  # output
