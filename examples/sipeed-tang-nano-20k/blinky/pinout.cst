// Constraint file of the blinky example for the Sipeed Tang Nano 20K board.
// It assigns the design's signals to FPGA pins, and lists only
// the pins that this example uses.

// Clock (27MHz).
IO_LOC  "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP IO_TYPE=LVCMOS33 BANK_VCCIO=3.3;

// LED, active low.
IO_LOC  "led" 15;
IO_PORT "led" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33 BANK_VCCIO=3.3;
