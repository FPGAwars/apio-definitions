// Constraint file of the speed-test example for the Sipeed Tang Nano 20K board.
// It assigns the design's signals to FPGA pins, and lists only
// the pins that this example uses.

// Clock (27MHz).
IO_LOC  "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Per https://github.com/YosysHQ/nextpnr/issues/1515
CLOCK_LOC "sys_clk" BUFG;

// LED, active low.
IO_LOC  "led_n" 15;
IO_PORT "led_n" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
