# Constraint file of the rgb-led example for the iCESugar 1.5 board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 35  # input

# RGB LED, active low.
set_io rgb_led_n[0] 40  # output, red
set_io rgb_led_n[1] 41  # output, green
set_io rgb_led_n[2] 39  # output, blue
