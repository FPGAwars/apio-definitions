# Constraint file of the leds example for the iCEstick board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# ------------ User Leds (active high) ----------------------------------------
set_io leds[0] 99  # output
set_io leds[1] 98  # output
set_io leds[2] 97  # output
set_io leds[3] 96  # output
set_io leds[4] 95  # output
