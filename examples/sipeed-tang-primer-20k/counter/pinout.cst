//
// icebreaker 7-seg PMOD v1.1a on the Lite top-right PMOD.
//
//   1 AA T6   2 AB T7   3 AC T8   4 AD T9   5 GND   6 3V3
//   7 AE P6   8 AF R8   9 AG P8  10 CAT P9 11 GND  12 3V3
//
// Segments active-low. CAT multiplexes the two digits.
//------------------------------------------------------------------

IO_LOC  "sys_clk" H11;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;

IO_LOC  "segs_n[0]" T6;   // AA
IO_LOC  "segs_n[1]" T7;   // AB
IO_LOC  "segs_n[2]" T8;   // AC
IO_LOC  "segs_n[3]" T9;   // AD
IO_LOC  "segs_n[4]" P6;   // AE
IO_LOC  "segs_n[5]" R8;   // AF
IO_LOC  "segs_n[6]" P8;   // AG
IO_LOC  "digit_sel" P9;   // CAT
IO_PORT "segs_n[0]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[1]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[2]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[3]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[4]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[5]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[6]" IO_TYPE=LVCMOS33;
IO_PORT "digit_sel" IO_TYPE=LVCMOS33;

// Per https://github.com/YosysHQ/nextpnr/issues/1515
CLOCK_LOC "sys_clk" BUFG;
