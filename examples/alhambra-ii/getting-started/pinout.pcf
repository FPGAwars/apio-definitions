# Constraint file of the getting-started example for the Alhambra II board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# ------------ System clock (12MHz) -------------------------------------------
set_io sys_clk 49  # input

# ------------ User Leds (active high) ----------------------------------------
set_io leds[0] 37  # output, LED7 on the board
set_io leds[1] 38  # output, LED6 on the board
