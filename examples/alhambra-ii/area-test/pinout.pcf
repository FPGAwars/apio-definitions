# Constraint file of the area-test example for the Alhambra II board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# ------------ System clock (12MHz) -------------------------------------------
set_io sys_clk 49  # input

# ------------ User Leds (active high) ----------------------------------------
set_io leds[0] 45  # output
set_io leds[1] 44  # output
set_io leds[2] 43  # output
set_io leds[3] 42  # output
set_io leds[4] 41  # output
set_io leds[5] 39  # output
set_io leds[6] 38  # output
set_io leds[7] 37  # output
