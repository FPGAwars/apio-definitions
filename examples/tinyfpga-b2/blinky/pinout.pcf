# Constraint file of the blinky example for the TinyFPGA B2 board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (16MHz).
set_io sys_clk B4  # input, pin 3

# LED, active high. The board has no user LED, so wire one from pin 13 to
# GND through a resistor (see README.md).
set_io led J1  # output, pin 13
