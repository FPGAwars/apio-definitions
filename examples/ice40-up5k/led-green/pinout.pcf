# Constraint file of the led-green example for the iCE40UP5K breakout board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# RGB LED, active low.
set_io rgb_led_n[0] 41  # output, red
set_io rgb_led_n[1] 40  # output, green
set_io rgb_led_n[2] 39  # output, blue
