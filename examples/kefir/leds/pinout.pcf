# Constraint file of the leds example for the Kéfir I board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# ------------ User Leds (active high) ----------------------------------------
set_io leds[0] 137  # output
set_io leds[1] 135  # output
set_io leds[2] 129  # output
set_io leds[3] 121  # output
