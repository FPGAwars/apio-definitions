# Constraint file of the rgb-led example for the Fomu board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (48MHz).
set_io sys_clk F4  # input

# RGB LED, active low. These are the iCE40UP5K's dedicated RGB LED pins.
set_io rgb_led[0] B5  # Red, RGB1.
set_io rgb_led[1] C5  # Green, RGB2.
set_io rgb_led[2] A5  # Blue, RGB0.

# USB pins, held low.
set_io usb_dp    A1  # output
set_io usb_dn    A2  # output
set_io usb_pu A4  # output, active high
